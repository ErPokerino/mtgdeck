# ============================================================================
# MTG Pro AI Workbench — Configurazione Ambiente
# ============================================================================

# "local" (Fase 1) | "gcp" (Fase 2)
ENVIRONMENT=local

# Database (SQLite FTS5 locale in Fase 1; Cloud SQL PostgreSQL URI in Fase 2)
# DATABASE_URL=sqlite:///./data/mtgdeck.db

# Provider AI: "gemini-api-key" (Fase 1) | "vertex-ai" (Fase 2)
AI_PROVIDER=gemini-api-key

# Fase 1: Gemini API Key (opzionale qui: si può inserire direttamente nei Settings della UI)
GEMINI_API_KEY=

# Fase 2: GCP Vertex AI / Model Garden
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
